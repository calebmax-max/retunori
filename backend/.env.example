APP_NAME=RETUNORI API
# Local development:
DATABASE_URL=sqlite:///./retunori.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/database
APP_ENV=development
AUTOMATIC_BACKUPS_ENABLED=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_CALLBACK_URL=https://your-public-domain.example/api/payments/daraja/callback?callback_secret=replace-with-a-long-random-provider-secret
DARAJA_CALLBACK_SECRET=replace-with-a-long-random-provider-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
